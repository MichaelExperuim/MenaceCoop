# WHITELIST: this folder is also the dev workspace (test logs, saves, tester
# logs, release zips, decompiled game code). Nothing is published unless it is
# listed here, so none of that can be committed by accident.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/MenaceCoop-README.md
!/CHANGELOG.md
!/DeveloperDocs/
!/tools/
!/Launch-MelonCoopTest.ps1
!/Build-MelonRelease.ps1
# The harness's starting campaigns (only the three it uses).
!/testsave/
/testsave/*
!/testsave/building_test.save
!/testsave/building_test.jpg
!/testsave/pirate_test.save
!/testsave/pirate_test.jpg
!/testsave/alien_test.save
!/testsave/alien_test.jpg
!/Directory.Build.props
!/MenaceCoop/
!/MenaceCoopMelon/
!/Shared/
!/.vscode/
!/.github/

# Build output
bin/
obj/
